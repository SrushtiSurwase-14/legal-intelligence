# Copy to .env and edit. Nothing here is required for the default (offline) mode.
LI_CORPUS_DIR=data/corpus
LI_TRACE_DIR=logs
LI_ANALYZER_MODE=extractive      # extractive | llm
LI_RETRIEVER=bm25                # bm25 | hybrid (hybrid needs sentence-transformers)
LI_LLM_PROVIDER=none             # none | anthropic
LI_LLM_MODEL=claude-sonnet-5-5   # verify the current model name in Anthropic docs
ANTHROPIC_API_KEY=
LI_TOP_K=5
LI_MIN_SCORE=0.5
LI_MIN_COVERAGE=0.30
LI_SIMULATE_FAILURE=             # retriever | source | llm  (for demos/tests only)
LI_TODAY=                        # YYYY-MM-DD, pins "today" for reproducible runs
LI_LOG_LEVEL=INFO
